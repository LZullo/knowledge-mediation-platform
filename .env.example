# Copie para `.env` na raiz do repositório e ajuste conforme o ambiente.
# Nunca versionar o arquivo `.env`.

APP_NAME=Knowledge Mediation Platform API
DEBUG=false

# PostgreSQL — no servidor: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/mba
DB_ECHO_SQL=false

# Deve bater com o modelo (MiniLM L6 v2 = 384).
VECTOR_DIMENSIONS=384
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Reranking (CrossEncoder local)
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K_DEFAULT=10
# RERANK_SCORE_THRESHOLD=

# Provedor de LLM: openai | ollama
LLM_PROVIDER=ollama

# OpenAI — https://platform.openai.com/api-keys (somente se LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_BASE_URL=

# Ollama local
OLLAMA_MODEL=phi3
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_SEED=

# Geração (valores usados nos experimentos controlados)
LLM_TEMPERATURE=0.0
OLLAMA_NUM_PREDICT=256
OLLAMA_REPEAT_PENALTY=1.15
