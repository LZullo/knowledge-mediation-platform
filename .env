# Copie para app/.env e ajuste conforme o ambiente.
APP_NAME=MBA API
DEBUG=false

# PostgreSQL — no servidor: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/rag_tcc
DB_ECHO_SQL=false
# Deve bater com o modelo (MiniLM L6 v2 = 384).
VECTOR_DIMENSIONS=384
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Reranking (CrossEncoder local)
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K_DEFAULT=10
# RERANK_SCORE_THRESHOLD=  # opcional

# Provedor de LLM: openai | ollama (padrão do projeto: ollama + phi3)
LLM_PROVIDER=ollama
OLLAMA_MODEL=phi3
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Chat: gpt-3.5-turbo | gpt-4o-mini | gpt-4o | ...
OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_BASE_URL=  # opcional (proxies, Azure OpenAI, etc.)

